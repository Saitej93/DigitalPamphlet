<script>
// ═══════════════════════════
// QR CODE GENERATION
// ═══════════════════════════
window.addEventListener('load', function() {
  var url = window.location.href;
  // If opened as file:// or no URL, use a descriptive URL
  if (!url || url === 'about:blank' || url.startsWith('blob:')) {
    url = 'https://homedean.in/home-health-quiz';
  }
  try {
    new QRCode(document.getElementById('qrcode'), {
      text: url,
      width: 100,
      height: 100,
      colorDark: '#1a2940',
      colorLight: '#f5f0e8',
      correctLevel: QRCode.CorrectLevel.M
    });
  } catch(e) {
    // Fallback: show a placeholder
    document.getElementById('qrcode').innerHTML =
      '<div style="width:100px;height:100px;background:#f5f0e8;display:flex;align-items:center;justify-content:center;font-size:10px;color:#1a2940;text-align:center;padding:8px;">Scan QR at homedean.in</div>';
  }
  // Restore loyalty state from localStorage
  loadLoyaltyState();
});

// ═══════════════════════════
// QUIZ LOGIC
// ═══════════════════════════
var answers = {};

function selectAnswer(q, val, btn) {
  answers[q] = val;
  var opts = btn.parentElement.querySelectorAll('.quiz-btn');
  opts.forEach(function(b) { b.className = 'quiz-btn'; });
  btn.className = 'quiz-btn ' + (val === 'yes' ? 'yes-sel' : 'no-sel');
  document.getElementById('qq' + q).classList.add('answered');
}

function calculateScore() {
  // Count "no" answers (issues found)
  var noCount = 0;
  for (var i = 0; i < 8; i++) {
    if (answers[i] === 'no') noCount++;
  }

  var totalAnswered = Object.keys(answers).length;
  if (totalAnswered < 8) {
    alert('Please answer all 8 questions to reveal your personalised discount!');
    return;
  }

  var discount, code, title, msg, fine;

  if (noCount <= 2) {
    discount = '5%';
    code = 'HDHEALTHY5';
    title = 'Your Home is in Good Shape! 🏡';
    msg = 'Great news — your home is well-maintained. Here\'s a 5% thank-you discount as a reward for being a proactive homeowner. Use it on your next service booking.';
    fine = 'Code valid 30 days · All services · 1 use per household';
  } else if (noCount <= 5) {
    discount = '10%';
    code = 'HDCARE10';
    title = 'Your Home Needs Some Care 🔧';
    msg = 'Your home has a few areas that need attention. Book now with 10% off — small fixes today prevent expensive repairs tomorrow. Our expert team is ready.';
    fine = 'Code valid 30 days · All services · 1 use per household';
  } else {
    discount = '15%';
    code = 'HDURGENT15';
    title = 'Your Home Needs Urgent Attention ⚠️';
    msg = 'Several systems in your home need professional care. We\'re giving you 15% off because acting now saves you significantly more in emergency repairs. Book today.';
    fine = 'Code valid 21 days · Urgent Priority Booking · 1 use · Call immediately';
  }

  // Build score bar
  var barHtml = '';
  for (var j = 0; j < 8; j++) {
    barHtml += '<div class="score-dot' + (answers[j] === 'no' ? ' filled' : '') + '"></div>';
  }
  document.getElementById('scoreBar').innerHTML = barHtml;

  document.getElementById('resultLabel').textContent =
    noCount + ' issues found out of 8 questions';
  document.getElementById('resultTitle').textContent = title;
  document.getElementById('resultMsg').textContent = msg;
  document.getElementById('promoDiscount').innerHTML =
    discount + '<span class="promo-off"> OFF</span>';
  document.getElementById('promoCode').textContent = code;
  document.getElementById('resultFine').textContent = fine;

  var rb = document.getElementById('resultBox');
  rb.className = 'result-box show';
  rb.scrollIntoView({ behavior: 'smooth', block: 'center' });
}

// ═══════════════════════════
// SEASONAL TASKS TOGGLE
// ═══════════════════════════
function toggleTask(taskEl) {
  var circle = taskEl.querySelector('.task-circle');
  circle.classList.toggle('done');
}

// ═══════════════════════════
// LOYALTY STAMP CARD
// ═══════════════════════════
var loyaltyState = [false, false, false, false];

function loadLoyaltyState() {
  try {
    var saved = localStorage.getItem('hd_loyalty');
    if (saved) {
      loyaltyState = JSON.parse(saved);
      // Unlock circles first
      for (var i = 0; i < 4; i++) {
        var circle = document.getElementById('lc' + i);
        circle.classList.remove('locked');
      }
      // Re-apply state
      for (var i = 0; i < 4; i++) {
        if (loyaltyState[i]) {
          applyFilled(i);
        }
      }
      updateLoyaltyUI();
    } else {
      // First time: unlock circles so user can tap them
      for (var i = 0; i < 4; i++) {
        document.getElementById('lc' + i).classList.remove('locked');
      }
    }
  } catch(e) {
    for (var i = 0; i < 4; i++) {
      document.getElementById('lc' + i).classList.remove('locked');
    }
  }
}

function applyFilled(index) {
  var circle = document.getElementById('lc' + index);
  var icon = document.getElementById('ci' + index);
  circle.classList.add('filled');
  circle.classList.remove('reward', 'locked');
  icon.textContent = '●';
  if (index < 4) {
    document.getElementById('cc' + index).classList.add('active');
  }
}

function toggleCircle(index) {
  loyaltyState[index] = !loyaltyState[index];
  if (loyaltyState[index]) {
    applyFilled(index);
  } else {
    // Unfill
    var circle = document.getElementById('lc' + index);
    var icon = document.getElementById('ci' + index);
    circle.classList.remove('filled');
    circle.classList.add('reward');
    icon.textContent = '○';
    document.getElementById('cc' + index).classList.remove('active');
  }
  try { localStorage.setItem('hd_loyalty', JSON.stringify(loyaltyState)); } catch(e){}
  updateLoyaltyUI();
}

function updateLoyaltyUI() {
  var count = loyaltyState.filter(Boolean).length;
  var statusText = document.getElementById('statusText');
  var statusHint = document.getElementById('statusHint');
  var rewardIcon = document.getElementById('rewardIcon');
  var rewardTitle = document.getElementById('rewardTitle');
  var rewardDesc = document.getElementById('rewardDesc');
  var lc4 = document.getElementById('lc4');
  var ci4 = document.getElementById('ci4');
  var cl4 = document.getElementById('cl4');

  statusText.textContent = count + ' of 4 services booked';

  if (count === 0) {
    statusHint.textContent = 'Tap circles below to mark your bookings';
    rewardIcon.textContent = '🏆';
    rewardTitle.textContent = 'Start Your Loyalty Journey';
    rewardDesc.textContent = 'Each HomeDean booking fills one circle. Book 4 services and unlock 20% off your 5th. Call 7075482626 after each service to register.';
    lc4.className = 'loyalty-circle reward locked';
    ci4.textContent = '🎁';
    cl4.style.color = 'rgba(200,169,110,0.5)';
    cl4.textContent = '20% OFF';
  } else if (count === 1) {
    statusHint.textContent = '3 more services to go!';
    rewardIcon.textContent = '⭐';
    rewardTitle.textContent = 'Great Start! 1 Service Done';
    rewardDesc.textContent = 'You\'re on your way! Book 3 more HomeDean services to unlock your 20% discount reward.';
  } else if (count === 2) {
    statusHint.textContent = '2 more services to your reward!';
    rewardIcon.textContent = '⭐⭐';
    rewardTitle.textContent = 'Halfway There! 2 Services Done';
    rewardDesc.textContent = 'Excellent! You\'ve used HomeDean twice. Just 2 more bookings to unlock your exclusive 20% discount.';
  } else if (count === 3) {
    statusHint.textContent = 'Just 1 more — you\'re almost there!';
    rewardIcon.textContent = '🔥';
    rewardTitle.textContent = 'Almost There! 3 Services Done';
    rewardDesc.textContent = 'One more HomeDean service and your 20% discount unlocks! Call 7075482626 to book your 4th service now.';
  } else if (count === 4) {
    statusHint.style.color = '#c8a96e';
    statusHint.textContent = '🎉 Reward Unlocked! Show this to claim 20% OFF';
    rewardIcon.textContent = '🎉';
    rewardTitle.textContent = '20% Discount Unlocked!';
    rewardDesc.innerHTML = '<strong style="color:#c8a96e;font-size:14px;">Congratulations!</strong> You\'ve completed 4 HomeDean services. Show this filled card when calling to claim your <strong style="color:#c8a96e;">20% discount</strong> on your next booking. Call <strong style="color:#c8a96e;">7075482626</strong>';
    // Activate reward circle
    lc4.className = 'loyalty-circle reward';
    ci4.textContent = '🎁';
    cl4.style.color = '#1a2940';
    cl4.textContent = '20% OFF';
    cl4.style.fontWeight = 'bold';
    document.getElementById('cc3').classList.add('active');
  }
}

// Initialise - unlock all 4 bookable circles
document.addEventListener('DOMContentLoaded', function() {
  for (var i = 0; i < 4; i++) {
    document.getElementById('lc' + i).classList.remove('locked');
  }
});
</script>

