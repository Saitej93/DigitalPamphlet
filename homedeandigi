  font-size:18px;letter-spacing:0.12em;color:#f5f0e8;
}
.footer-logo span{color:var(--gold);}
.footer-tagline{font-size:8.5px;color:var(--slate);letter-spacing:0.25em;text-transform:uppercase;margin-top:2px;}
.footer-links{font-size:10px;color:var(--slate);line-height:1.9;text-align:center;}
.footer-social{font-size:10px;color:var(--slate);line-height:1.9;text-align:right;}

/* GOLD RULE DIVIDER */
.gold-rule{
  height:1px;
  background:linear-gradient(90deg,transparent,var(--gold),transparent);
}

/* ══ UTILITIES ══ */
.text-gold{color:var(--gold);}
.text-slate{color:var(--slate);}

