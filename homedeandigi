<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HomeDean — Home Health Quiz & Exclusive Offer</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap');

*{box-sizing:border-box;margin:0;padding:0;}

:root{
  --navy:#1a2940;
  --navy2:#122030;
  --navy3:#0d1825;
  --steel:#2e5b8a;
  --gold:#c8a96e;
  --gold2:#e0c48a;
  --gold3:#f0ddb0;
  --warm:#f5f0e8;
  --warm2:#ede5d5;
  --slate:#7a8fa6;
  --blue-fill:#2563eb;
  --blue-light:#dbeafe;
}

html{scroll-behavior:smooth;}
body{
  font-family:'DM Sans',sans-serif;
  background:var(--warm2);
  color:var(--navy);
}

.pamphlet{max-width:700px;margin:0 auto;box-shadow:0 0 80px rgba(26,41,64,0.18);}

/* ── COVER PANEL ── */
.cover{
  background:var(--navy3);
  padding:0;
  position:relative;
  overflow:hidden;
}
.cover-bg-pattern{
  position:absolute;inset:0;
  background-image:
    radial-gradient(circle at 80% 20%, rgba(200,169,110,0.08) 0%, transparent 50%),
    radial-gradient(circle at 10% 80%, rgba(46,91,138,0.2) 0%, transparent 50%),
    repeating-linear-gradient(45deg, rgba(255,255,255,0.012) 0px, rgba(255,255,255,0.012) 1px, transparent 1px, transparent 40px);
  pointer-events:none;
}

/* LOGO HEADER */
.logo-header{
  padding:28px 40px 24px;
  border-bottom:1px solid rgba(200,169,110,0.15);
  display:flex;
  align-items:center;
  justify-content:space-between;
  position:relative;
  z-index:1;
}
.logo-lockup{display:flex;align-items:center;gap:14px;}
.logo-icon-wrap{flex-shrink:0;}
.logo-wordmark{
  font-family:'Playfair Display',serif;
  font-size:22px;
  font-weight:700;
  letter-spacing:0.18em;
  color:#f5f0e8;
}
.logo-wordmark span{color:var(--gold);}
.logo-tagline{
  font-family:'DM Sans',sans-serif;
  font-size:8.5px;
  letter-spacing:0.35em;
  color:var(--slate);
  text-transform:uppercase;
  margin-top:2px;
}
.cover-badge{
  display:flex;align-items:center;gap:6px;
  background:rgba(200,169,110,0.12);
  border:1px solid rgba(200,169,110,0.3);
  padding:6px 14px;border-radius:20px;
}
.cover-badge-dot{width:5px;height:5px;background:var(--gold);border-radius:50%;animation:pulse 2s ease-in-out infinite;}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:0.4;}}
.cover-badge-text{font-size:9px;color:var(--gold);letter-spacing:0.2em;text-transform:uppercase;}

/* HERO SECTION */
.cover-hero{
  padding:40px 40px 36px;
  position:relative;z-index:1;
}
.hero-eyebrow{
  font-size:9px;letter-spacing:0.5em;color:var(--gold);
  text-transform:uppercase;margin-bottom:14px;
  display:flex;align-items:center;gap:10px;
}
.hero-eyebrow::before{
  content:'';display:block;width:24px;height:1px;background:var(--gold);
}
.hero-h1{
  font-family:'Playfair Display',serif;
  font-size:clamp(28px,5vw,40px);
  font-weight:400;
  color:#f5f0e8;
  line-height:1.18;
  letter-spacing:0.03em;
  margin-bottom:10px;
}
.hero-h1 em{color:var(--gold);font-style:italic;}
.hero-sub{
  font-size:13px;color:var(--slate);line-height:1.7;
  max-width:380px;margin-bottom:28px;
}

/* SCAN STRIP */
.scan-strip{
  background:rgba(200,169,110,0.07);
  border:1px solid rgba(200,169,110,0.22);
  border-radius:12px;
  padding:18px 22px;
  display:flex;align-items:center;gap:20px;
}
.qr-wrap{
  flex-shrink:0;
  background:#f5f0e8;
  padding:8px;border-radius:8px;
  border:2px solid var(--gold);
}
#qrcode canvas,#qrcode img{display:block;}
.scan-label{font-size:9px;letter-spacing:0.3em;color:var(--gold);text-transform:uppercase;margin-bottom:6px;}
.scan-title{
  font-family:'Playfair Display',serif;
  font-size:16px;color:#f5f0e8;margin-bottom:4px;
}
.scan-desc{font-size:11px;color:var(--slate);line-height:1.6;}
.scan-arrow{
  margin-left:auto;flex-shrink:0;
  width:36px;height:36px;
  background:var(--gold);border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-size:16px;
}

/* REASONS ROW */
.reasons-row{
  display:grid;grid-template-columns:repeat(3,1fr);
  gap:1px;
  background:rgba(200,169,110,0.1);
  border-top:1px solid rgba(200,169,110,0.1);
  position:relative;z-index:1;
}
.reason{
  padding:18px 16px;
  background:rgba(26,41,64,0.5);
  text-align:center;
}
.reason-num{
  font-family:'Playfair Display',serif;
  font-size:22px;color:var(--gold);line-height:1;margin-bottom:4px;
}
.reason-text{font-size:10px;color:var(--slate);letter-spacing:0.05em;line-height:1.4;}

/* DIVIDER */
.divider{height:2px;background:linear-gradient(90deg,transparent,var(--gold),transparent);}

/* ═══ QUIZ PANEL ═══ */
.quiz-panel{background:var(--warm);padding:40px;}

.panel-header{text-align:center;margin-bottom:30px;}
.panel-label{
  font-size:9px;letter-spacing:0.5em;color:var(--gold);
  text-transform:uppercase;margin-bottom:10px;
}
.panel-title{
  font-family:'Playfair Display',serif;
  font-size:28px;font-weight:400;
  color:var(--navy);margin-bottom:8px;
}
.panel-title span{color:var(--steel);}
.panel-desc{font-size:12px;color:#6a7580;line-height:1.7;max-width:460px;margin:0 auto;}

.discount-ladder{
  display:flex;gap:10px;margin-bottom:28px;
  padding:16px;
  background:var(--navy3);
  border-radius:10px;
}
.dl-item{
  flex:1;text-align:center;padding:12px 8px;
  border-radius:8px;border:1px solid rgba(200,169,110,0.18);
  background:rgba(26,41,64,0.6);
}
.dl-score{font-size:10px;color:var(--slate);letter-spacing:0.1em;margin-bottom:4px;}
.dl-discount{
  font-family:'Playfair Display',serif;
  font-size:20px;font-weight:700;color:var(--gold);
}
.dl-label{font-size:9px;color:rgba(200,169,110,0.6);margin-top:2px;}
.dl-item.active{background:rgba(200,169,110,0.12);border-color:rgba(200,169,110,0.4);}

/* QUIZ QUESTIONS */
.quiz-grid{display:flex;flex-direction:column;gap:10px;margin-bottom:22px;}
.quiz-q{
  background:#fff;border:1px solid var(--warm2);
  border-radius:12px;padding:16px 18px;
  transition:border-color 0.2s;
}
.quiz-q.answered{border-color:var(--gold);}
.quiz-q-num{
  font-size:9px;letter-spacing:0.2em;color:var(--gold);
  text-transform:uppercase;margin-bottom:6px;
}
.quiz-q-text{
  font-family:'Playfair Display',serif;
  font-size:14px;color:var(--navy);
  margin-bottom:12px;line-height:1.4;
}
.quiz-options{display:flex;gap:8px;}
.quiz-btn{
  flex:1;padding:9px 8px;
  border:1.5px solid var(--warm2);border-radius:8px;
  background:var(--warm);
  font-family:'DM Sans',sans-serif;font-size:12px;
  cursor:pointer;transition:all 0.18s;
  color:var(--navy);font-weight:500;
}
.quiz-btn:hover{border-color:var(--gold);background:var(--warm2);}
.quiz-btn.yes-sel{background:var(--navy);border-color:var(--navy);color:#f5f0e8;}
.quiz-btn.no-sel{background:#fff3e0;border-color:var(--gold);color:#7a4800;}

/* CALCULATE BUTTON */
.calc-row{text-align:center;}
.calc-btn{
  background:linear-gradient(135deg,var(--navy) 0%,var(--steel) 100%);
  color:#f5f0e8;border:none;
  padding:15px 52px;
  font-family:'DM Sans',sans-serif;font-size:13px;
  letter-spacing:0.18em;text-transform:uppercase;
  border-radius:4px;cursor:pointer;
  position:relative;overflow:hidden;
  transition:transform 0.2s,box-shadow 0.2s;
  box-shadow:0 4px 20px rgba(26,41,64,0.3);
}
.calc-btn::after{
  content:'';position:absolute;top:0;left:-100%;
  width:100%;height:100%;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,0.1),transparent);
  transition:left 0.5s;
}
.calc-btn:hover{transform:translateY(-2px);box-shadow:0 8px 28px rgba(26,41,64,0.4);}
.calc-btn:hover::after{left:100%;}

/* RESULT BOX */
.result-box{
  display:none;
  margin-top:20px;
  border-radius:14px;
  overflow:hidden;
  box-shadow:0 8px 40px rgba(26,41,64,0.2);
}
.result-box.show{display:block;animation:fadeSlideUp 0.5s ease forwards;}
@keyframes fadeSlideUp{
  from{opacity:0;transform:translateY(20px);}
  to{opacity:1;transform:translateY(0);}
}
.result-top{
  background:var(--navy3);
  padding:28px 28px 20px;
  text-align:center;
}
.result-label{
  font-size:9px;letter-spacing:0.4em;color:var(--slate);
  text-transform:uppercase;margin-bottom:10px;
}
.result-score-bar{
  display:flex;gap:5px;justify-content:center;margin-bottom:14px;
}
.score-dot{
  width:28px;height:6px;border-radius:3px;
  background:rgba(255,255,255,0.12);
  transition:background 0.3s;
}
.score-dot.filled{background:var(--gold);}
.result-title{
  font-family:'Playfair Display',serif;
  font-size:22px;color:#f5f0e8;margin-bottom:8px;line-height:1.3;
}
.result-msg{font-size:12px;color:var(--slate);line-height:1.7;max-width:380px;margin:0 auto 20px;}

.promo-card{
  background:linear-gradient(135deg,var(--gold) 0%,var(--gold2) 100%);
  border-radius:10px;padding:18px 24px;
  display:inline-block;
  box-shadow:0 4px 20px rgba(200,169,110,0.4);
}
.promo-label{font-size:9px;color:rgba(26,41,64,0.7);letter-spacing:0.3em;text-transform:uppercase;margin-bottom:5px;}
.promo-discount{
  font-family:'Playfair Display',serif;
  font-size:48px;font-weight:700;
  color:var(--navy3);line-height:1;
}
.promo-off{font-size:18px;font-weight:400;}
.promo-code-wrap{margin-top:8px;}
.promo-code{
  font-family:'Courier New',monospace;font-size:16px;
  font-weight:700;color:var(--navy3);
  letter-spacing:0.25em;
  background:rgba(255,255,255,0.4);
  padding:4px 12px;border-radius:4px;
}

.result-bottom{
  background:var(--warm);padding:16px 28px 20px;
  text-align:center;
}
.result-contact{
  font-size:12px;color:#6a7580;margin-bottom:8px;
}
.result-phone{
  font-family:'Playfair Display',serif;
  font-size:22px;color:var(--navy);letter-spacing:0.08em;
}
.result-phone span{color:var(--gold);}
.result-fine{font-size:10px;color:#9aA8b5;margin-top:6px;}

/* ═══ SERVICES PANEL ═══ */
.services-panel{background:var(--navy3);padding:40px;}
.svc-header{margin-bottom:24px;}
.svc-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;}
.svc-card{
  background:rgba(255,255,255,0.04);
  border:1px solid rgba(200,169,110,0.15);
  border-radius:12px;padding:20px 18px;
  transition:border-color 0.2s,transform 0.2s;
  cursor:default;
}
.svc-card:hover{border-color:rgba(200,169,110,0.4);transform:translateY(-2px);}
.svc-icon-ring{
  width:40px;height:40px;
  background:rgba(200,169,110,0.1);
  border:1px solid rgba(200,169,110,0.25);
  border-radius:10px;
  display:flex;align-items:center;justify-content:center;
  margin-bottom:14px;
  font-size:18px;
}
.svc-name{
  font-family:'Playfair Display',serif;
  font-size:14px;color:#f5f0e8;margin-bottom:5px;
}
.svc-desc{font-size:10.5px;color:var(--slate);line-height:1.55;}
.svc-cta{
  margin-top:10px;
  display:inline-flex;align-items:center;gap:5px;
  font-size:10px;color:var(--gold);letter-spacing:0.1em;
  text-transform:uppercase;
}
.svc-wide{grid-column:1/-1;}
.svc-wide .svc-inner{display:flex;gap:16px;align-items:flex-start;}

/* PROMISE BANNER */
.promise-banner{
  margin-top:18px;
  background:linear-gradient(135deg,rgba(200,169,110,0.15),rgba(200,169,110,0.05));
  border:1px solid rgba(200,169,110,0.3);
  border-radius:10px;padding:16px 20px;
  display:flex;align-items:center;gap:14px;
}
.promise-check{
  width:36px;height:36px;flex-shrink:0;
  background:var(--gold);border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-size:16px;
}
.promise-text{font-size:12px;color:#f5f0e8;font-weight:500;line-height:1.5;}
.promise-sub{font-size:10px;color:var(--slate);margin-top:2px;}

/* ═══ SEASONAL PLANNER ═══ */
.seasonal-panel{background:var(--warm);padding:40px;}
.seasonal-intro{
  background:var(--navy3);border-radius:10px;padding:16px 20px;
  margin-bottom:24px;
  display:flex;align-items:center;gap:16px;
}
.seasonal-intro-icon{font-size:24px;flex-shrink:0;}
.seasonal-intro-text{font-size:12px;color:var(--slate);line-height:1.6;}
.seasonal-intro-text strong{color:var(--gold);}
.seasons-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:16px;}
.season-card{
  background:#fff;
  border-radius:12px;overflow:hidden;
  border:1px solid var(--warm2);
  box-shadow:0 2px 12px rgba(26,41,64,0.06);
}
.season-header{
  padding:12px 16px;
  display:flex;align-items:center;gap:10px;
}
.season-icon{font-size:20px;}
.season-name{
  font-family:'Playfair Display',serif;
  font-size:14px;font-weight:600;
}
.season-months{font-size:9px;color:var(--slate);letter-spacing:0.1em;text-transform:uppercase;}
.season-tasks{padding:10px 16px 14px;}
.season-task{
  display:flex;align-items:center;gap:10px;
  padding:7px 0;
  border-bottom:1px solid var(--warm2);
  font-size:11.5px;color:#3a4a5a;
  cursor:pointer;
}
.season-task:last-child{border-bottom:none;}
.task-circle{
  width:18px;height:18px;flex-shrink:0;
  border:2px solid var(--warm2);border-radius:50%;
  transition:all 0.2s;
  cursor:pointer;display:flex;align-items:center;justify-content:center;
}
.task-circle.done{
  background:var(--navy);border-color:var(--navy);
}
.task-circle.done::after{content:'✓';font-size:9px;color:#fff;}
.season-cta{
  margin:10px 16px 14px;
  display:flex;align-items:center;justify-content:space-between;
}
.season-call{
  font-size:10px;color:var(--gold);font-weight:600;letter-spacing:0.05em;
}
.season-num{font-size:12px;color:var(--navy);font-weight:700;letter-spacing:0.08em;}

/* Summer */
.season-summer .season-header{background:#fff8e6;}
.season-summer .season-name{color:#c87d00;}
/* Monsoon */
.season-monsoon .season-header{background:#e6f0fa;}
.season-monsoon .season-name{color:#1a5b8a;}
/* Post-monsoon */
.season-postmonsoon .season-header{background:#edf7ed;}
.season-postmonsoon .season-name{color:#256025;}
/* Winter */
.season-winter .season-header{background:#f0e6f7;}
.season-winter .season-name{color:#6025a0;}

/* ═══ LOYALTY SCRATCH CARD ═══ */
.loyalty-panel{background:var(--navy);padding:40px;}
.loyalty-title-row{text-align:center;margin-bottom:6px;}
.loyalty-eyebrow{font-size:9px;letter-spacing:0.4em;color:var(--gold);text-transform:uppercase;margin-bottom:8px;}
.loyalty-title{
  font-family:'Playfair Display',serif;
  font-size:24px;color:#f5f0e8;margin-bottom:6px;
}
.loyalty-sub{font-size:12px;color:var(--slate);margin-bottom:28px;line-height:1.6;}

/* CARD VISUAL */
.loyalty-card{
  background:linear-gradient(145deg,var(--navy3) 0%,#0e1e30 100%);
  border:1px solid rgba(200,169,110,0.25);
  border-radius:16px;
  padding:28px 24px;
  position:relative;
  overflow:hidden;
  box-shadow:0 12px 40px rgba(0,0,0,0.3);
  margin-bottom:24px;
}
.loyalty-card::before{
  content:'';position:absolute;
  top:-40px;right:-40px;
  width:180px;height:180px;
  background:radial-gradient(circle,rgba(200,169,110,0.08) 0%,transparent 70%);
}
.loyalty-card-header{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:22px;
}
.loyalty-card-brand{
  font-family:'Playfair Display',serif;
  font-size:16px;letter-spacing:0.12em;color:#f5f0e8;
}
.loyalty-card-brand span{color:var(--gold);}
.loyalty-card-tag{
  font-size:9px;color:var(--slate);
  letter-spacing:0.2em;text-transform:uppercase;
}

/* CIRCLES ROW */
.circles-row{
  display:flex;align-items:center;justify-content:center;
  gap:16px;margin-bottom:20px;
}
.loyalty-circle{
  width:64px;height:64px;
  border-radius:50%;
  border:2.5px solid rgba(200,169,110,0.3);
  background:rgba(255,255,255,0.03);
  display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  cursor:pointer;
  transition:all 0.3s ease;
  position:relative;
  user-select:none;
}
.loyalty-circle:hover:not(.filled):not(.reward){
  border-color:rgba(200,169,110,0.6);
  background:rgba(200,169,110,0.06);
  transform:scale(1.05);
}
.loyalty-circle.filled{
  background:linear-gradient(135deg,#1d4ed8,#2563eb);
  border-color:#3b82f6;
  box-shadow:0 4px 20px rgba(37,99,235,0.4);
  transform:scale(1.05);
}
.loyalty-circle.filled .circle-num{color:rgba(255,255,255,0.7);}
.loyalty-circle.filled .circle-icon{font-size:20px;}
.loyalty-circle.reward{
  background:linear-gradient(135deg,var(--gold) 0%,var(--gold2) 100%);
  border-color:var(--gold2);
  box-shadow:0 4px 24px rgba(200,169,110,0.5);
  animation:glowPulse 2s ease-in-out infinite;
}
@keyframes glowPulse{
  0%,100%{box-shadow:0 4px 24px rgba(200,169,110,0.5);}
  50%{box-shadow:0 4px 36px rgba(200,169,110,0.8),0 0 0 6px rgba(200,169,110,0.15);}
}
.loyalty-circle.reward.locked{
  background:rgba(255,255,255,0.04);
  border-color:rgba(200,169,110,0.3);
  animation:none;box-shadow:none;
  cursor:not-allowed;
}
.circle-num{font-size:9px;color:var(--slate);letter-spacing:0.1em;margin-bottom:2px;}
.circle-icon{font-size:22px;transition:all 0.3s;}
.circle-label{font-size:8px;color:var(--slate);margin-top:2px;letter-spacing:0.08em;}

.circle-connector{
  height:2px;flex:1;max-width:20px;
  background:rgba(200,169,110,0.15);
  border-radius:1px;
  transition:background 0.5s;
}
.circle-connector.active{background:rgba(37,99,235,0.5);}

/* REWARD REVEAL */
.reward-reveal{
  background:rgba(200,169,110,0.08);
  border:1px solid rgba(200,169,110,0.2);
  border-radius:10px;padding:14px 18px;
  display:flex;align-items:center;gap:14px;
}
.reward-reveal-icon{font-size:28px;}
.reward-reveal-text{font-size:11.5px;color:var(--slate);line-height:1.6;}
.reward-reveal-text strong{color:#f5f0e8;font-size:13px;}
.loyalty-instructions{
  display:grid;grid-template-columns:1fr 1fr 1fr;
  gap:10px;
  margin-top:16px;
}
.li-step{
  background:rgba(255,255,255,0.03);
  border:1px solid rgba(200,169,110,0.1);
  border-radius:8px;padding:14px;text-align:center;
}
.li-step-num{
  font-family:'Playfair Display',serif;
  font-size:20px;color:rgba(200,169,110,0.5);margin-bottom:6px;
}
.li-step-text{font-size:10.5px;color:var(--slate);line-height:1.5;}

/* ═══ EMERGENCY PANEL ═══ */
.emergency-panel{background:var(--navy3);padding:40px;}
.emer-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:20px;}
.emer-card{border-radius:10px;padding:12px 14px;}
.emer-card.homedean{
  background:linear-gradient(135deg,var(--gold) 0%,var(--gold2) 100%);
